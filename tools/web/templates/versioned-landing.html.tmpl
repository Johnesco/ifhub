<!-- generated by build_landing.py -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{TITLE}} &mdash; IF Hub</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="ifhub:title" content="{{TITLE}}">
<meta name="ifhub:meta" content="{{META}}">
<meta name="ifhub:description" content="{{DESCRIPTION}}">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  height: 100%;
  background: #0a0a0a;
  color: #d4c5a9;
  font-family: Georgia, "Times New Roman", serif;
}

body {
  min-height: 100%;
  max-width: 740px;
  margin: 0 auto;
  padding: 60px 24px 80px;
  line-height: 1.7;
}

.breadcrumb { font-size: 0.85em; color: #887755; margin-bottom: 24px; }
.breadcrumb a { color: #887755; border-bottom-color: #3a3020; }
.breadcrumb a:hover { color: #e8d090; }

h1 { font-size: 1.8em; color: #e8d8b0; letter-spacing: 1px; margin-bottom: 6px; }
.subtitle { font-style: italic; color: #aa9966; margin-bottom: 40px; }

h2 {
  font-size: 1.2em;
  color: #c4b48a;
  margin-top: 48px;
  margin-bottom: 16px;
  padding-bottom: 6px;
  border-bottom: 1px solid #2a2418;
}

p { margin-bottom: 16px; }

a {
  color: #e8d090;
  text-decoration: none;
  border-bottom: 1px solid #5a4a30;
  transition: color 0.15s, border-color 0.15s;
}
a:hover { color: #ffe8a0; border-bottom-color: #aa9966; }

.play-latest {
  display: inline-block;
  margin-bottom: 16px;
  margin-right: 12px;
  padding: 10px 28px;
  background: #2a2010;
  border: 1px solid #5a4a30;
  border-radius: 4px;
  color: #e8d090;
  font-family: inherit;
  font-size: 1em;
  letter-spacing: 0.5px;
  text-decoration: none;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}
.play-latest:hover { background: #3a3018; color: #ffe8a0; border-color: #aa9966; }

.version-entry {
  margin-bottom: 32px;
  padding: 20px 24px;
  background: #111;
  border: 1px solid #1e1a14;
  border-radius: 6px;
}
.version-entry.primary { border-color: #5a4a30; }
.version-entry h3 { color: #c4b48a; font-size: 1.05em; margin-bottom: 10px; }
.version-entry p { font-size: 0.95em; color: #b0a080; margin-bottom: 8px; }
.version-entry ul { margin: 8px 0 12px 20px; font-size: 0.92em; color: #b0a080; }
.version-entry li { margin-bottom: 4px; }

.version-links { display: flex; gap: 20px; font-size: 0.95em; flex-wrap: wrap; }
.version-links a { color: #b0a080; border-bottom-color: #2a2418; }
.version-links a:hover { color: #e8d090; }

.version-action {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 14px;
  flex-wrap: wrap;
}
.version-action select {
  padding: 6px 10px;
  font-size: 0.9em;
  font-family: inherit;
  background: #1a1610;
  color: #d4c5a9;
  border: 1px solid #2a2418;
  border-radius: 4px;
  cursor: pointer;
}
.version-action label {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.85em;
  color: #aa9966;
  cursor: pointer;
  border-bottom: none;
}
.version-action input[type="checkbox"] {
  accent-color: #e8d090;
  width: 14px;
  height: 14px;
  cursor: pointer;
}
.version-action button {
  padding: 6px 18px;
  font-size: 0.9em;
  font-family: inherit;
  font-weight: bold;
  letter-spacing: 1px;
  background: #e8d090;
  color: #0a0a0a;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.15s;
}
.version-action button:hover { background: #ffe8a0; }

.version-nav { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px; }
.version-nav a, .version-nav span {
  display: inline-block;
  padding: 6px 16px;
  border: 1px solid #2a2418;
  border-radius: 4px;
  font-size: 0.9em;
  text-decoration: none;
}
.version-nav a { color: #b0a080; border-bottom: none; }
.version-nav a:hover { background: #2a2010; color: #e8d090; border-color: #5a4a30; }
.version-nav .current { background: #2a2010; color: #e8d090; border-color: #5a4a30; }

footer {
  margin-top: 60px;
  padding-top: 20px;
  border-top: 1px solid #1e1a14;
  font-size: 0.85em;
  color: #665a40;
}
footer a { color: #887755; border-bottom-color: #3a3020; }
</style>
</head>
<body>

<nav class="breadcrumb"><a href="/ifhub/">IF Hub</a> &rsaquo; {{TITLE}}</nav>

<h1>{{TITLE}}</h1>
<p class="subtitle">{{SUBTITLE}}</p>

<a class="play-latest" href="{{PRIMARY_PLAY_URL}}">{{PRIMARY_CTA_LABEL}}</a>
<a class="play-latest" href="/ifhub/app.html?game={{PRIMARY_ID}}">Play in IF Hub</a>

{{INTRO_HTML}}

<h2>Versions</h2>

<div class="version-nav">
{{VERSION_NAV}}
</div>

{{VERSION_ENTRIES}}

{{OUTRO_HTML}}

<footer>
<p><a href="/ifhub/">&larr; Back to IF Hub</a></p>
</footer>

<script>
// Delegated handler for version-action GO buttons. Mirrors the IF Hub card:
// fullscreen -> direct URL; otherwise -> /ifhub/app.html?game=<id>&view=<view>.
document.addEventListener('click', function(ev) {
  var btn = ev.target.closest('.version-action .va-go');
  if (!btn) return;
  var box = btn.closest('.version-action');
  var action = box.querySelector('.va-action').value;
  var fullscreen = box.querySelector('.va-fs input').checked;
  var gid = box.getAttribute('data-gid');
  var url = box.getAttribute('data-' + action) || box.getAttribute('data-play');
  var view = action === 'source' ? 'source'
           : action === 'walkthrough' ? 'walkthrough'
           : 'game';
  // Fullscreen opens the game's own play page; source and walkthrough are hub views.
  window.location.href = (fullscreen && action === 'play') ? url : ('/ifhub/app.html?game=' + gid + '&view=' + view);
});
</script>

</body>
</html>
